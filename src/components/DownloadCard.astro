---
// src/components/DownloadCard.astro
const { cuarto, portadaBase64 } = Astro.props;
---

<!-- Contenedor del Botón y la Tarjeta -->
<div class="flex justify-center w-full mt-4">
  {cuarto.activo ? (
    <button
      id="download-btn"
      class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition-colors flex items-center justify-center gap-2 w-full sm:w-auto"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
      </svg>
      Descargar Tarjeta
    </button>
  ) : (
    <button disabled class="bg-gray-400 text-white px-6 py-3 rounded-lg cursor-not-allowed opacity-60 flex items-center justify-center gap-2 w-full sm:w-auto">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
      Descarga No Disponible
    </button>
  )}
</div>

<!-- Tarjeta oculta para descarga -->
<div id="download-card" class="download-hidden">
  <div class="download-card w-full h-full text-white p-8 flex flex-col justify-between" style="background: linear-gradient(135deg, #4f46e5, #3b82f6);">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 bg-white bg-opacity-20 rounded-full flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
          </svg>
        </div>
        <div>
          <h1 class="text-2xl font-bold">RANTU</h1>
          <p class="text-sm opacity-80">Tu próximo hogar</p>
        </div>
      </div>
      <div class="text-right">
        <div class="text-3xl font-bold">${cuarto.precio.toLocaleString()}</div>
        <div class="text-sm opacity-80">por mes</div>
      </div>
    </div>

    <!-- Contenido principal -->
    <div class="flex-1 flex items-center justify-between py-8">
      <div class="w-80 h-60 rounded-xl overflow-hidden shadow-2xl bg-gray-200">
        <img src={portadaBase64} alt={cuarto.titulo} class="w-full h-full object-cover" />
      </div>

      <div class="flex-1 pl-8">
        <h2 class="text-4xl font-bold mb-4 leading-tight">{cuarto.titulo}</h2>
        <p class="text-lg opacity-90 mb-6 leading-relaxed line-clamp-4">{cuarto.descripcion}</p>
        <div class="space-y-2">
          <div class="flex items-center space-x-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span>{cuarto.caracteristicas ? cuarto.caracteristicas.split(",")[0] : "Completamente amueblado"}</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span>{cuarto.ubicacion ? cuarto.ubicacion.split(",")[0] : "Ubicación céntrica"}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="flex items-center justify-between">
      <div class="text-sm opacity-80">🏠 Encuentra más opciones en R A N T U</div>
      <div class="text-sm opacity-80">Generado el {new Date().toLocaleDateString("es-ES")}</div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ cuarto }}>
  const downloadBtn = document.getElementById("download-btn");
  
  if (downloadBtn) {
    downloadBtn.addEventListener("click", async function () {
      const originalText = downloadBtn.innerHTML;

      try {
        downloadBtn.innerHTML = `
          <svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          Generando...
        `;
        downloadBtn.disabled = true;

        const card = document.getElementById("download-card");
        
        // Fix: Mover la tarjeta al viewport pero oculta para evitar que html-to-image falle
        const originalCssText = card.style.cssText;
        const originalClassName = card.className;
        card.className = "download-card w-full text-white p-8 flex flex-col justify-between";
        card.style.position = "absolute";
        card.style.top = "0px";
        card.style.left = "0px";
        card.style.width = "800px";
        card.style.height = "600px";
        card.style.zIndex = "-1000";
        card.style.opacity = "0";

        const dataUrl = await htmlToImage.toPng(card, {
          width: 800,
          height: 600,
          pixelRatio: 2,
          style: {
            transform: 'none',
            opacity: '1'
          }
        });
        
        // Restaurar estado original
        card.className = originalClassName;
        card.style.cssText = originalCssText;

        const link = document.createElement("a");
        link.download = `cuarto-${encodeURIComponent(cuarto.titulo)}-${Date.now()}.png`;
        link.href = dataUrl;

        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        alert("¡Tarjeta descargada exitosamente!");
      } catch (error) {
        console.error("Error generando tarjeta:", error);
        alert("Error al generar la tarjeta: " + (error.message || error));
      } finally {
        downloadBtn.innerHTML = originalText;
        downloadBtn.disabled = false;
      }
    });
  }
</script>
