---
export interface Props {
  cuarto: {
    id: number;
    titulo?: string;
    name?: string;
    precio: number;
    activo: boolean;
    latitud?: number;
    longitud?: number;
    imagen_1?: string;
    descripcion: string;
  };
}

const { cuarto } = Astro.props;
---

<div
  class="cuarto-card border rounded-lg overflow-hidden hover:shadow-lg transition-all duration-300 bg-white dark:bg-gray-800 transform hover:-translate-y-1"
  data-precio={cuarto.precio}
  data-disponible={cuarto.activo ? "true" : "false"}
  data-id={cuarto.id}
  data-titulo={cuarto.titulo || "Cuarto disponible"}
  data-lat={cuarto.latitud || ""}
  data-lng={cuarto.longitud || ""}
  data-img={cuarto.imagen_1 || "/Images/default.jpeg"}
>
  <div class="relative group">
    <img
      src={cuarto.imagen_1 || "/Images/default.jpeg"}
      alt={`Imagen del cuarto: ${cuarto.titulo || "Cuarto disponible"}`}
      class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
      onerror="this.src='/Images/default.jpeg'; this.onerror=null;"
    />
    {cuarto.activo && (
      <div class="absolute top-3 left-3 bg-green-500 text-white px-3 py-1 rounded-full text-xs font-semibold shadow-lg">
        ✓ Disponible
      </div>
    )}
    {!cuarto.activo && (
      <div class="absolute top-3 left-3 bg-red-500 text-white px-3 py-1 rounded-full text-xs font-semibold shadow-lg">
        ✗ No disponible
      </div>
    )}
    <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300" />
  </div>

  <div class="p-5">
    <h2 class="text-xl font-semibold mb-2 text-gray-800 dark:text-gray-200 line-clamp-1">
      {cuarto.titulo || cuarto.name || "Cuarto disponible"}
    </h2>

    <p class="text-gray-600 mb-4 line-clamp-2 text-sm leading-relaxed">
      {cuarto.descripcion}
    </p>

    <div class="flex justify-between items-center">
      <div class="flex flex-col">
        <span class="text-2xl font-bold text-blue-600">
          ${cuarto.precio.toLocaleString()}
        </span>
        <span class="text-sm text-gray-500">por mes</span>
      </div>

      <a
        href={`/cuarto/${cuarto.id}`}
        aria-label={`Ver detalles del cuarto: ${cuarto.titulo || "Cuarto disponible"} - $${cuarto.precio.toLocaleString()} pesos por mes`}
        class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg transition-all duration-200 shadow-sm hover:shadow-md font-medium transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
      >
        Ver más →
      </a>
    </div>
  </div>
</div>
