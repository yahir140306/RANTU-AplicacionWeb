---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div
    class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4 sm:px-6 lg:px-8"
  >
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-6xl font-bold text-gray-900 dark:text-gray-100 mb-4">
          ¿Qué es <span class="text-blue-600">RANTU</span>?
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          La plataforma número 1 para encontrar y publicar cuartos disponibles
          en México
        </p>
      </div>

      <!-- Contenido Principal -->
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-8 md:p-12 space-y-8">
        <!-- ¿Qué es RANTU? -->
        <section>
          <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-6">
            🏠 ¿Qué es RANTU?
          </h2>
          <div class="prose prose-lg text-gray-700 dark:text-gray-300 space-y-4">
            <p>
              <strong>RANTU</strong> es la aplicación web más confiable para <strong
                >buscar y publicar cuartos disponibles</strong
              > en México. Conectamos a estudiantes, trabajadores y familias que
              buscan un lugar donde vivir con propietarios que tienen cuartos disponibles.
            </p>
            <p>
              Con <strong>RANTU</strong>, encontrar tu cuarto ideal es <em
                >rápido, fácil y seguro</em
              >. Nuestra plataforma cuenta con cientos de cuartos verificados,
              precios transparentes y comunicación directa entre inquilinos y
              propietarios.
            </p>
          </div>
        </section>

        <!-- Características principales -->
        <section>
          <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-6">
            ✨ ¿Por qué elegir RANTU?
          </h2>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-blue-50 p-6 rounded-xl">
              <h3 class="text-xl font-semibold text-blue-900 mb-3">
                🔍 Búsqueda Inteligente
              </h3>
              <p class="text-blue-800">
                Filtra por precio, ubicación y características. Encuentra
                exactamente lo que buscas con nuestro sistema de búsqueda
                avanzada.
              </p>
            </div>

            <div class="bg-green-50 p-6 rounded-xl">
              <h3 class="text-xl font-semibold text-green-900 mb-3">
                📱 100% Gratis
              </h3>
              <p class="text-green-800">
                Sin comisiones ocultas. Publica y busca cuartos completamente
                gratis. Solo conectamos personas de manera transparente.
              </p>
            </div>

            <div class="bg-purple-50 p-6 rounded-xl">
              <h3 class="text-xl font-semibold text-purple-900 mb-3">
                🚀 Súper Rápido
              </h3>
              <p class="text-purple-800">
                Aplicación web moderna y optimizada para dispositivos móviles.
                Rápida y responsiva en navegadores.
              </p>
            </div>

            <div class="bg-orange-50 p-6 rounded-xl">
              <h3 class="text-xl font-semibold text-orange-900 mb-3">
                🔒 Seguro y Confiable
              </h3>
              <p class="text-orange-800">
                Todos los usuarios están verificados. Comunicación segura vía
                WhatsApp. Tu privacidad es nuestra prioridad.
              </p>
            </div>
          </div>
        </section>

        <!-- Para quién es RANTU -->
        <section>
          <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-6">
            👥 ¿Para quién es RANTU?
          </h2>
          <div class="space-y-4">
            <div class="flex items-start space-x-4 p-4 bg-gray-50 rounded-lg">
              <span class="text-2xl">🎓</span>
              <div>
                <h3 class="font-semibold text-lg">Estudiantes</h3>
                <p class="text-gray-600">
                  Encuentra cuartos cerca de tu universidad o escuela. Precios
                  accesibles para estudiantes.
                </p>
              </div>
            </div>

            <div class="flex items-start space-x-4 p-4 bg-gray-50 rounded-lg">
              <span class="text-2xl">💼</span>
              <div>
                <h3 class="font-semibold text-lg">Trabajadores</h3>
                <p class="text-gray-600">
                  Cuartos cerca de zonas industriales y centros de trabajo.
                  Perfectos para profesionistas.
                </p>
              </div>
            </div>

            <div class="flex items-start space-x-4 p-4 bg-gray-50 rounded-lg">
              <span class="text-2xl">🏠</span>
              <div>
                <h3 class="font-semibold text-lg">Propietarios</h3>
                <p class="text-gray-600">
                  Publica tus cuartos gratis y encuentra inquilinos confiables
                  rápidamente.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Cómo funciona -->
        <section>
          <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-6">
            🔧 ¿Cómo funciona RANTU?
          </h2>
          <div class="grid md:grid-cols-3 gap-6 text-center">
            <div>
              <div
                class="bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <span class="text-2xl font-bold text-blue-600">1</span>
              </div>
              <h3 class="font-semibold text-lg mb-2">Regístrate Gratis</h3>
              <p class="text-gray-600">
                Crea tu cuenta en menos de 2 minutos. No necesitas tarjeta de
                crédito.
              </p>
            </div>

            <div>
              <div
                class="bg-green-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <span class="text-2xl font-bold text-green-600">2</span>
              </div>
              <h3 class="font-semibold text-lg mb-2">Busca o Publica</h3>
              <p class="text-gray-600">
                Encuentra cuartos disponibles o publica el tuyo con fotos y
                descripción.
              </p>
            </div>

            <div>
              <div
                class="bg-purple-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <span class="text-2xl font-bold text-purple-600">3</span>
              </div>
              <h3 class="font-semibold text-lg mb-2">Contacta Directo</h3>
              <p class="text-gray-600">
                Habla directamente con el propietario vía WhatsApp. Sin
                intermediarios.
              </p>
            </div>
          </div>
        </section>

        <!-- Keywords para SEO -->
        <section class="hidden">
          <p>
            RANTU cuartos disponibles renta habitaciones estudiantes
            trabajadores México app cuartos buscar cuartos publicar cuartos
            alquiler habitaciones renta cuartos baratos cuartos cerca
            universidad cuartos amueblados plataforma cuartos online aplicación
            cuartos web
          </p>
        </section>

        <!-- Call to Action -->
        <div class="text-center pt-8 border-t">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4">
            ¿Listo para encontrar tu cuarto ideal?
          </h2>
          <div class="space-x-4">
            <a
              href="/"
              class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium px-8 py-3 rounded-lg transition-colors"
            >
              Ver Cuartos Disponibles
            </a>
            <a
              href="/agregar-cuarto"
              class="inline-block bg-green-600 hover:bg-green-700 text-white font-medium px-8 py-3 rounded-lg transition-colors"
            >
              Publicar mi Cuarto
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .prose p {
    line-height: 1.7;
  }
</style>
